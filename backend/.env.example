# Salin file ini jadi .env  ->  cp .env.example .env
PORT=4000
NODE_ENV=development

# WAJIB diganti sebelum deploy ke server beneran
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
JWT_EXPIRES_IN=8h

# Origin frontend yang boleh akses API (pisah dengan koma)
CORS_ORIGIN=http://localhost:5173

# Driver database: auto (default) | node | better-sqlite3
# auto = pakai SQLite bawaan Node kalau ada, kalau tidak baru better-sqlite3
DB_DRIVER=auto

# Nama fasilitas yang dicetak di kop ringkasan PDF
FACILITY_NAME=Posyandu Melati

# Batas ukuran file upload (byte). Default 50MB sesuai desain.
MAX_UPLOAD_BYTES=52428800
