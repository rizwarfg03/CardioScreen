# ==========================================
# CardioSync Pro - Production Environment
# ==========================================
# Salin file ini jadi .env.production di server produksi, LALU isi nilai
# aslinya di sana. Jangan pernah commit .env.production ke git — file itu
# sudah masuk .gitignore.
#
#   cp .env.production.example .env.production

# Server Configuration
PORT=3000
NODE_ENV=production

# Frontend URL / CORS — WAJIB diisi domain asli aplikasi kamu.
# Backend membaca CORS_ORIGIN (lihat backend/src/config/index.js);
# FRONTEND_URL ikut diisi sama supaya konsisten dan gampang dibaca orang.
# Bisa lebih dari satu origin, dipisah koma.
FRONTEND_URL=https://ganti-dengan-domain-kamu.contoh
CORS_ORIGIN=https://ganti-dengan-domain-kamu.contoh

# Secret Keys - SECURITY CRITICAL
# WAJIB dibuat baru untuk tiap deployment, jangan pakai nilai contoh apa pun.
# Generate dengan: openssl rand -hex 32
JWT_SECRET=

# Tambahan Keamanan (Global Pepper) — string acak lain, beda dari JWT_SECRET.
# Generate dengan: openssl rand -hex 32
PASSWORD_SALT=

# Database
# Karena pakai SQLite, ini path ke volume docker internal.
DB_PATH=./data/cardiosync.db
